# Application
APP_NAME=IDEP
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://idep_user:idep_password@localhost:5432/idep_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# LLM Configuration
LLM_PROVIDER=openai              # openai | anthropic | azure_openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OCR Configuration
OCR_ENGINE=tesseract              # tesseract | paddleocr
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng+hin              # eng, hin, etc.

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/idep.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Streamlit
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
